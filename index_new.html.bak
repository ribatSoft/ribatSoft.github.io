<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ribatsoft | Indie Developer Portal</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-dark: #070a12;
            --bg-card: #0f172a;
            --bg-card-hover: #1e293b;
            --accent-blue: #00d2ff;
            --accent-cyan: #3a7bd5;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #1e293b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', 'Cairo', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            width: 100%;
            overflow-x: hidden;
        }

        /* Support du mode RTL pour l'Arabe */
        [dir="rtl"] {
            font-family: 'Cairo', 'Inter', sans-serif;
        }

        /* Hero & Header avec image de fond pleine largeur */
        .hero-header-wrapper {
            position: relative;
            width: 100%;
            background: linear-gradient(180deg, rgba(7, 10, 18, 0.75) 0%, rgba(7, 10, 18, 0.95) 100%), 
                        url('banner2.jpg') center/cover no-repeat;
            border-bottom: 1px solid var(--border-color);
        }

        /* Navbar */
        header {
            width: 100%;
            padding: 1.2rem 5%;
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .nav-container {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-main);
        }

        .brand img {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            border: 1px solid rgba(0, 210, 255, 0.3);
        }

        .brand-text span:first-child {
            font-weight: 700;
            font-size: 1.3rem;
            display: block;
            background: linear-gradient(90deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-text span:last-child {
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--accent-blue);
        }

        /* Commutateur de langue */
        .lang-switcher {
            display: flex;
            gap: 4px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 4px;
        }

        .lang-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            padding: 5px 12px;
            border-radius: 14px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .lang-btn.active {
            background: var(--accent-blue);
            color: #000;
        }

        /* Hero Content */
        .hero-content {
            width: 100%;
            padding: 5rem 5% 6rem 5%;
            text-align: center;
        }

        .indie-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 210, 255, 0.12);
            color: var(--accent-blue);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 2rem;
            border: 1px solid rgba(0, 210, 255, 0.3);
            backdrop-filter: blur(5px);
        }

        .hero-content h1 {
            font-size: 3rem;
            margin-bottom: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .hero-content h1 span {
            color: var(--accent-blue);
        }

        .hero-content p {
            max-width: 800px;
            margin: 0 auto 3rem auto;
            color: var(--text-muted);
            font-size: 1.2rem;
            line-height: 1.8;
        }

        /* Grille des caractéristiques en pleine largeur */
        .grid-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            width: 100%;
            margin-top: 2rem;
        }

        .stat-card {
            background-color: rgba(15, 23, 42, 0.65);
            padding: 1.8rem;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            backdrop-filter: blur(10px);
            transition: border-color 0.3s;
        }

        .stat-card:hover {
            border-color: rgba(0, 210, 255, 0.4);
        }

        .stat-card i {
            font-size: 1.8rem;
            color: var(--accent-blue);
            margin-bottom: 12px;
        }

        .stat-card h4 {
            font-size: 1.1rem;
            margin-bottom: 6px;
        }

        .stat-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0;
        }

        /* Sections pleine largeur */
        .full-width-section {
            width: 100%;
            padding: 5rem 5%;
        }

        .full-width-section:nth-child(even) {
            background-color: rgba(15, 23, 42, 0.3);
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .section-subtitle {
            color: var(--text-muted);
            margin-bottom: 3rem;
            font-size: 1.05rem;
        }

        /* Card À Propos */
        .about-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
        }

        .about-card p {
            margin-bottom: 1.2rem;
            color: var(--text-muted);
            font-size: 1.05rem;
        }

        /* Grille des Applications (Full Width) */
        .app-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            width: 100%;
        }

        .app-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.2rem;
            transition: transform 0.3s, border-color 0.3s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .app-card:hover {
            transform: translateY(-6px);
            border-color: var(--accent-blue);
        }

        .app-header {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 1.2rem;
        }

        .app-icon {
            width: 72px;
            height: 72px;
            border-radius: 16px;
            object-fit: cover;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .app-title {
            font-size: 1.3rem;
            font-weight: 700;
        }

        .app-category {
            font-size: 0.85rem;
            color: var(--accent-blue);
            font-weight: 600;
        }

        .app-desc {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 2rem;
            line-height: 1.7;
        }

        .btn-playstore {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background-color: #000;
            color: #fff;
            padding: 12px 24px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            border: 1px solid #333;
            transition: background 0.3s;
            width: fit-content;
        }

        .btn-playstore:hover {
            background-color: #1a1a1a;
        }

        .btn-disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Section app-ads.txt */
        .ads-box {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
        }

        .ads-code {
            background-color: #030712;
            padding: 1.2rem;
            border-radius: 8px;
            font-family: 'Fira Code', monospace;
            font-size: 0.95rem;
            color: #00ffca;
            overflow-x: auto;
            margin: 1.5rem 0;
            border: 1px solid rgba(255, 255, 255, 0.05);
            direction: ltr;
            text-align: left;
        }

        /* Modals */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            max-width: 650px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 2.5rem;
            position: relative;
        }

        .close-btn {
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 1.8rem;
            color: var(--text-muted);
            cursor: pointer;
        }

        [dir="rtl"] .close-btn {
            right: auto;
            left: 25px;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--border-color);
            padding: 3rem 5%;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.95rem;
            background-color: rgba(7, 10, 18, 0.95);
        }

        @media (max-width: 900px) {
            nav {
                display: none;
            }
            .hero-content h1 {
                font-size: 2.2rem;
            }
            .app-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- Header & Hero Wrapper avec l'image de fond -->
    <div class="hero-header-wrapper">
        <header>
            <div class="nav-container">
                <a href="#" class="brand">
                    <img src="iconDev.jpg" alt="Ribatsoft Icon">
                    <div class="brand-text">
                        <span>ribatsoft</span>
                        <span>Software | Development | Excellence</span>
                    </div>
                </a>
                <nav>
                    <a href="#about" data-i18n="nav-about">À propos</a>
                    <a href="#apps" data-i18n="nav-apps">Applications</a>
                    <a href="#app-ads" data-i18n="nav-ads">app-ads.txt</a>
                    <a href="#contact" data-i18n="nav-contact">Contact</a>
                    
                    <div class="lang-switcher">
                        <button class="lang-btn" onclick="setLanguage('en', this)">EN</button>
                        <button class="lang-btn active" onclick="setLanguage('fr', this)">FR</button>
                        <button class="lang-btn" onclick="setLanguage('ar', this)">AR</button>
                    </div>
                </nav>
            </div>
        </header>

        <section class="hero-content">
            <div class="indie-badge">
                <i class="fa-solid fa-code"></i> <span data-i18n="hero-badge">Projet Développeur Indépendant</span>
            </div>

            <h1 data-i18n="hero-title">Création d'Applications Mobile <span>Simples & Pratiques</span></h1>
            <p data-i18n="hero-desc">
                Ribatsoft est un projet logiciel indépendant axé sur le développement d'outils éducatifs légers, d'utilitaires de révision quotidienne et de solutions numériques pratiques.
            </p>

            <div class="grid-stats">
                <div class="stat-card">
                    <i class="fa-solid fa-user-ninja"></i>
                    <h4 data-i18n="stat-1-title">Projet Indépendant</h4>
                    <p data-i18n="stat-1-desc">Conçu avec passion et soin</p>
                </div>
                <div class="stat-card">
                    <i class="fa-solid fa-shield-halved"></i>
                    <h4 data-i18n="stat-2-title">Confidentialité</h4>
                    <p data-i18n="stat-2-desc">Aucun accès inutile aux données</p>
                </div>
                <div class="stat-card">
                    <i class="fa-solid fa-check-circle"></i>
                    <h4 data-i18n="stat-3-title">Vérifié AdMob</h4>
                    <p data-i18n="stat-3-desc">Fichier app-ads.txt officiel</p>
                </div>
                <div class="stat-card">
                    <i class="fa-solid fa-envelope-open-text"></i>
                    <h4 data-i18n="stat-4-title">Support Direct</h4>
                    <p data-i18n="stat-4-desc">Réponses rapides par e-mail</p>
                </div>
            </div>
        </section>
    </div>

    <!-- Section À propos -->
    <section id="about" class="full-width-section">
        <h2 class="section-title" data-i18n="about-title">À propos de Ribatsoft</h2>
        <p class="section-subtitle" data-i18n="about-subtitle">Transparence et engagement personnel envers la qualité logicielle.</p>
        
        <div class="about-card">
            <p data-i18n="about-p1">
                <strong>Ribatsoft</strong> est un portfolio de développeur indépendant dédié à la création d'applications Android fonctionnelles conçues pour l'utilité quotidienne, l'apprentissage et la productivité.
            </p>
            <p data-i18n="about-p2">
                Plutôt que d'opérer comme un grand studio d'entreprise, Ribatsoft se concentre sur le développement individuel et artisanal d'applications — en privilégiant la rapidité, un design épuré et le respect strict de la confidentialité et des règles Google Play Console.
            </p>
        </div>
    </section>

    <!-- Section Applications -->
    <section id="apps" class="full-width-section">
        <h2 class="section-title" data-i18n="apps-title">Applications Publiées & À Venir</h2>
        <p class="section-subtitle" data-i18n="apps-subtitle">Découvrez nos applications officielles sur le Google Play Store.</p>

        <div class="app-grid">
            
            <!-- App 1: Quran Revision -->
            <div class="app-card">
                <div>
                    <div class="app-header">
                        <img src="https://play-lh.googleusercontent.com/JZDASzM-t0FS-yXHOek_rbP_HdasTRnIfh5DiKkpo1V0VYztHwpED23yBjZ9D7j8bXKfWDkyXwy7LJcoiyLfVQ=w240-h480-rw" alt="Quran Revision App" class="app-icon">
                        <div>
                            <div class="app-title" data-i18n="app1-title">Ribatsoft Quran Revision</div>
                            <div class="app-category" data-i18n="app1-cat">Éducation / Utilitaires</div>
                        </div>
                    </div>
                    <p class="app-desc" data-i18n="app1-desc">
                        Un outil spécialisé conçu pour aider les utilisateurs dans la révision quotidienne structurée, le suivi de la mémorisation et la planification des cycles de révision du Saint Coran.
                    </p>
                </div>
                <a href="https://play.google.com/store/apps/details?id=com.ribatsoft.quranrevision" target="_blank" class="btn-playstore">
                    <i class="fa-brands fa-google-play"></i> <span data-i18n="btn-playstore">Disponible sur Google Play</span>
                </a>
            </div>

            <!-- App 2: School Tracker -->
            <div class="app-card">
                <div>
                    <div class="app-header">
                        <img src="iconDev.jpg" alt="School Fee Tracker App" class="app-icon">
                        <div>
                            <div class="app-title" data-i18n="app2-title">Suivi des Écoles & Frais d'Études</div>
                            <div class="app-category" data-i18n="app2-cat">Productivité / Gestion</div>
                        </div>
                    </div>
                    <p class="app-desc" data-i18n="app2-desc">
                        Une application intuitive pour les parents et tuteurs afin d'organiser la présence des élèves, tenir des journaux de paiement et suivre facilement les progrès éducatifs.
                    </p>
                </div>
                <span class="btn-playstore btn-disabled">
                    <i class="fa-solid fa-clock"></i> <span data-i18n="btn-soon">En Développement / Bientôt disponible</span>
                </span>
            </div>

        </div>
    </section>

    <!-- Section app-ads.txt -->
    <section id="app-ads" class="full-width-section">
        <h2 class="section-title" data-i18n="ads-title">AdMob & Vérification</h2>
        <p class="section-subtitle" data-i18n="ads-subtitle">Fichier officiel app-ads.txt hébergé pour l'identification du développeur.</p>

        <div class="ads-box">
            <p data-i18n="ads-desc">Ce point d'accès public vérifie la propriété développeur de Ribatsoft pour Google AdMob et les réseaux publicitaires :</p>
            <div class="ads-code">
                google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0
            </div>
            <p style="font-size: 0.9rem; color: var(--text-muted);">
                <span data-i18n="ads-link">Accès direct :</span> <a href="/app-ads.txt" style="color: var(--accent-blue);">https://ribatsoft.github.io/app-ads.txt</a>
            </p>
        </div>
    </section>

    <!-- Section Contact -->
    <section id="contact" class="full-width-section">
        <h2 class="section-title" data-i18n="contact-title">Support Développeur & Légal</h2>
        <p class="section-subtitle" data-i18n="contact-subtitle">Des questions, remarques ou demandes de suppression de données ?</p>

        <div class="about-card">
            <p><i class="fa-solid fa-envelope" style="color: var(--accent-blue); margin-right: 8px;"></i> <strong data-i18n="contact-email">E-mail de support direct :</strong> <a href="mailto:ribatsoft@gmail.com" style="color: var(--text-main); margin-left: 5px;">ribatsoft@gmail.com</a></p>
            <p style="margin-top: 1.5rem;">
                <a href="#" onclick="openModal('privacyModal'); return false;" style="color: var(--accent-blue); margin-right: 20px;" data-i18n="link-privacy">Politique de Confidentialité</a>
                <a href="#" onclick="openModal('termsModal'); return false;" style="color: var(--accent-blue);" data-i18n="link-terms">Conditions d'Utilisation</a>
            </p>
        </div>
    </section>

    <!-- Modal Privacy Policy -->
    <div id="privacyModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('privacyModal')">&times;</span>
            <h2 data-i18n="modal-privacy-title">Politique de Confidentialité</h2>
            <br>
            <p data-i18n="modal-privacy-p1">Chez Ribatsoft, accessible depuis https://ribatsoft.github.io, l'une de nos priorités principales est la confidentialité de nos visiteurs et utilisateurs d'applications.</p>
            <br>
            <p data-i18n="modal-privacy-p2">Les applications Ribatsoft sont conçues pour minimiser la collecte de données. Aucune donnée personnelle n'est vendue ou partagée avec des tiers non autorisés. Les données d'analyse ou de publicité sont traitées strictement via les protocoles standard Google Play Services et AdMob.</p>
            <br>
            <p data-i18n="modal-privacy-p3">Pour toute question ou demande de suppression de données, veuillez nous contacter à ribatsoft@gmail.com.</p>
        </div>
    </div>

    <!-- Modal Terms -->
    <div id="termsModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('termsModal')">&times;</span>
            <h2 data-i18n="modal-terms-title">Conditions d'Utilisation</h2>
            <br>
            <p data-i18n="modal-terms-p1">En téléchargeant ou en utilisant les applications Ribatsoft, ces conditions s'appliquent automatiquement à vous. Assurez-vous de les lire attentivement avant d'utiliser nos applications.</p>
            <br>
            <p data-i18n="modal-terms-p2">Toutes les applications sont fournies 'en l'état' sans garantie d'aucune sorte. Ribatsoft ne peut être tenu responsable des dommages indirects résultant de l'utilisation de l'application.</p>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p data-i18n="footer-text">&copy; 2026 Ribatsoft. Projet de développeur indépendant. Tous droits réservés.</p>
    </footer>

    <!-- Script de traduction globale (FR default) -->
    <script>
        const translations = {
            en: {
                "nav-about": "About",
                "nav-apps": "Applications",
                "nav-ads": "app-ads.txt",
                "nav-contact": "Contact",
                "hero-badge": "Independent Developer Project",
                "hero-title": "Crafting Simple & Practical <span>Mobile Apps</span>",
                "hero-desc": "Ribatsoft is an independent software project focused on developing lightweight educational tools, daily revision utilities, and practical digital solutions.",
                "stat-1-title": "Indie Project",
                "stat-1-desc": "Built with passion & care",
                "stat-2-title": "Privacy First",
                "stat-2-desc": "No unnecessary data access",
                "stat-3-title": "AdMob Verified",
                "stat-3-desc": "Official app-ads.txt setup",
                "stat-4-title": "Direct Support",
                "stat-4-desc": "Quick responses via email",
                "about-title": "About Ribatsoft",
                "about-subtitle": "Transparency and personal commitment to software quality.",
                "about-p1": "Ribatsoft is an independent developer portfolio dedicated to creating functional Android applications designed for everyday utility, learning, and productivity.",
                "about-p2": "Rather than operating as a large corporate studio, Ribatsoft focuses on individual, craft-like app development—prioritizing fast performance, clean design, and strict respect for user privacy and Google Play Console guidelines.",
                "apps-title": "Published & Upcoming Applications",
                "apps-subtitle": "Explore official apps maintained on the Google Play Store.",
                "app1-title": "Ribatsoft Quran Revision",
                "app1-cat": "Education / Utility",
                "app1-desc": "A specialized tool designed to assist users with structured daily revision, memorization tracking, and scheduled review cycles for the Holy Quran.",
                "btn-playstore": "Get it on Google Play",
                "app2-title": "School & Tuition Fee Tracker",
                "app2-cat": "Productivity / Management",
                "app2-desc": "An intuitive helper app for parents and tutors to organize student attendance, keep payment logs, and track educational progress easily.",
                "btn-soon": "In Development / Coming Soon",
                "ads-title": "AdMob & Verification",
                "ads-subtitle": "Official app-ads.txt file hosted for developer identification.",
                "ads-desc": "This public endpoint verifies Ribatsoft developer ownership for Google AdMob and ad networks:",
                "ads-link": "Direct access:",
                "contact-title": "Developer Support & Legal",
                "contact-subtitle": "Have questions, feedback, or data deletion requests?",
                "contact-email": "Direct Support Email:",
                "link-privacy": "Privacy Policy",
                "link-terms": "Terms of Service",
                "modal-privacy-title": "Privacy Policy",
                "modal-privacy-p1": "At Ribatsoft, accessible from https://ribatsoft.github.io, one of our main priorities is the privacy of our visitors and app users.",
                "modal-privacy-p2": "Ribatsoft applications are designed to minimize data collection. Personal user data is not sold or shared with unauthorized third parties. Any analytical or advertising data processed is handled strictly through standard Google Play Services and AdMob protocols.",
